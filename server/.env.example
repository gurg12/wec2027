# ── WEC 2027 server environment ──────────────────────────────────────────────
# Copy to server/.env and fill in your values. Never commit server/.env.

# Runtime
NODE_ENV=production
PORT=5000

# MongoDB Atlas (recommended for production)
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wec2027?retryWrites=true&w=majority

# CORS — set to your actual domain (no trailing slash)
# Example: https://wec2027.ca,https://www.wec2027.ca
CORS_ORIGIN=https://yourdomain.com

# Contact form inbox (optional)
CONTACT_INBOX=chair@wec27.ca
